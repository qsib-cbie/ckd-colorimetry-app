{
  "identifier": "local-desktop",
  "description": "The app-managed local analysis window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:event:default",
    "core:window:allow-set-theme",
    "allow-pick-path",
    "allow-reveal-path",
    "allow-save-download",
    "allow-quit"
  ]
}
