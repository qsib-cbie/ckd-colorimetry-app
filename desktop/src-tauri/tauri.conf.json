{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CKD Colorimetry",
  "version": "2.2.0",
  "identifier": "edu.northwestern.qsib.ckd-colorimetry",
  "build": { "frontendDist": "../../web/dist" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Local CKD colorimetric research analysis",
    "resources": { "../engine/ckd-engine/": "engine/ckd-engine/" },
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
